{
  "name": "@huseyinfiliz/show-password",
  "description": "A Flarum extension to toggle password visibility.",
  "license": "MIT",
  "version": "1.0.0",
  "private": true,
  "prettier": "@flarum/prettier-config",
  "dependencies": {
    "flarum-webpack-config": "^3.0.0",
    "webpack": "^5.65.0",
    "webpack-cli": "^5.0.0"
  },
  "devDependencies": {
    "@flarum/prettier-config": "*",
    "prettier": "^3.0.1"
  },
  "scripts": {
    "dev": "webpack --mode development --watch",
    "build": "webpack --mode production",
    "analyze": "npx -p @flarum/cli flarum-cli audit infra",
    "format": "prettier --write src/**/*.{ts,tsx,js,jsx}",
    "format-check": "prettier --check src/**/*.{ts,tsx,js,jsx}"
  }
}
