{
    "compilerOptions": {
        "jsx": "react",
        "jsxFactory": "m",
        "jsxFragmentFactory": "\"[\"",
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "node",
        "strict": true,
        "esModuleInterop": true,
        "outDir": "dist",
        "baseUrl": ".",
        "paths": {
            "flarum/*": ["../vendor/flarum/core/js/dist-typings/*"]
        }
    },
    "include": ["src/**/*"]
}
